{
  "schemaVersion": 1,
  "id": "simplewaypoints",
  "version": "${version}",
  "name": "Simple Waypoints",
  "description": "Client-side waypoints marked only by native 3D beacon beams. No floating labels, logo markers, or ground rings.",
  "authors": [
    "You"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.waypoints.WaypointsMod"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
